# Copy to .env for local development.

# Port the Express API listens on (Vite dev server proxies /api here).
PORT=3001

# DATABASE_URL selects the DB adapter by scheme:
#   sqlite:<path>     -> SQLite (local / small deploys)
#   postgres://...    -> Postgres (e.g. Render)
DATABASE_URL=sqlite:./data/fact-fluency.sqlite

# Postgres TLS: a non-localhost URL is encrypted but, by default, does NOT
# verify the server certificate — managed providers (Render/Heroku) sign with a
# CA the client doesn't hold. To verify for real, either put `?sslmode=verify-full`
# on DATABASE_URL or point PGSSLROOTCERT at a CA bundle:
#   PGSSLROOTCERT=/etc/ssl/certs/provider-ca.pem

# No cookie secret: the session cookie is an unsigned random opaque token whose
# entropy is the secret; the server-side auth_session row is the source of truth.

# Optional fluency-tuning overrides (defaults live in engine/threshold.ts).
# Apply calibration-run suggestions here instead of redeploying constants:
#   FF_FLUENCY_K=1.3          multiplier on the kid's rolling median
#   FF_FLUENCY_FLOOR_MS=1200  hard floor on the fast cutoff
#   FF_FLUENCY_COLD_START=20  correct samples before the warm threshold
#   FF_CEILING_ADD=6000       per-operation cold-start ceilings (ms)
#   FF_CEILING_SUB=6000
#   FF_CEILING_MUL=8000
#   FF_CEILING_DIV=8000

# Live-game timing overrides. Production values are deliberately human-paced,
# which makes them untestable, so the test suites shrink them:
#   FF_WS_PING_MS=30000         WebSocket liveness probe interval (both games)
#   FF_RACE_COUNTDOWN_MS=3000   live-race countdown before `go`
#   FF_FEAST_ROUND_MS=90000     Number Feast round length

# Integration tests only (npm run test:pg sets this itself): a real Postgres to
# run the Db contract against. Unset = those tests skip.
#   FF_TEST_PG_URL=postgres://factfluency:factfluency@127.0.0.1:55432/fact_fluency_test
