# Copy to .env for local development.

# Port the Express API listens on (Vite dev server proxies /api here).
PORT=3001

# DATABASE_URL selects the DB adapter by scheme:
#   sqlite:<path>     -> SQLite (local / small deploys)
#   postgres://...    -> Postgres (e.g. Render)
DATABASE_URL=sqlite:./data/fact-fluency.sqlite

# No cookie secret: the session cookie is an unsigned random opaque token whose
# entropy is the secret; the server-side auth_session row is the source of truth.
