# Copy to .env for local development.

# Port the Express API listens on (Vite dev server proxies /api here).
PORT=3001

# DATABASE_URL selects the DB adapter by scheme:
#   sqlite:<path>     -> SQLite (local / small deploys)
#   postgres://...    -> Postgres (e.g. Render)
DATABASE_URL=sqlite:./data/fact-fluency.sqlite

# No cookie secret: the session cookie is an unsigned random opaque token whose
# entropy is the secret; the server-side auth_session row is the source of truth.

# Optional fluency-tuning overrides (defaults live in engine/threshold.ts).
# Apply calibration-run suggestions here instead of redeploying constants:
#   FF_FLUENCY_K=1.3          multiplier on the kid's rolling median
#   FF_FLUENCY_FLOOR_MS=1200  hard floor on the fast cutoff
#   FF_FLUENCY_COLD_START=20  correct samples before the warm threshold
#   FF_CEILING_ADD=6000       per-operation cold-start ceilings (ms)
#   FF_CEILING_SUB=6000
#   FF_CEILING_MUL=8000
#   FF_CEILING_DIV=8000
